# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
# See README.md "Configuration" section for what each of these does.

# --- Nexus IQ ---
NEXUSFIX_IQ_URL=https://iq.corp.example.com
NEXUSFIX_IQ_USERNAME=your-iq-user-token-id
NEXUSFIX_IQ_PASSWORD=your-iq-user-token-secret

# --- GitHub (or GitHub Enterprise Server) ---
NEXUSFIX_GITHUB_TOKEN=ghp_your_token_here
# Only needed for GHES; defaults to https://api.github.com if unset.
# NEXUSFIX_GITHUB_API_URL=https://ghes.corp.example.com/api/v3

# --- Defaults for `nexusfix run` (optional; --app-id / --branch override these) ---
# NEXUSFIX_APP_ID is the Nexus IQ *public* application ID, and must also be a key in
# config.yml's `repos:` map.
NEXUSFIX_APP_ID=payments-core
NEXUSFIX_BRANCH=main

# --- Optional ---
# Where mirror clones and per-run worktrees are created. Defaults to ~/nfx.
# NEXUSFIX_WORKSPACE_ROOT=/Users/you/nfx

# "mock" or "copilot". Selects the agent backend when wiring the CLI's --mock-agent
# flag through to a real Orchestrator (see README "What's real vs. unverified").
# NEXUSFIX_AGENT_BACKEND=copilot

# --- TLS (corporate proxy / self-signed CA) ---
# Preferred: point at your corporate root CA so certificates are still verified.
# NEXUSFIX_CA_BUNDLE=C:\certs\corporate-root-ca.pem
#
# Or have it fetched once and cached, instead of curl-ing it by hand on every machine.
# It is downloaded to <workspace_root>/tools/corporate-ca.pem, reused on every later run,
# and lives outside any git working tree so it cannot be committed.
# NEXUSFIX_CA_BUNDLE_URL=https://pki.corp.example.com/corporate-root-ca.pem
#
# Set this to the sha256 the first download logs. Worth doing: that first fetch CANNOT
# verify the certificate it is fetching — there is no CA to verify with yet, which is the
# whole problem being solved — so the checksum is the only thing establishing that what
# arrived is your organisation's CA rather than one substituted in transit. Everything
# afterwards trusts whatever this file contains.
# NEXUSFIX_CA_BUNDLE_SHA256=
#
# No `export` or `$env:` needed for any of this, on any platform: these are read from this
# file by the tool itself, never from your shell, so Git Bash, PowerShell, cmd and zsh all
# behave identically. If you set NEXUSFIX_CA_BUNDLE to a Windows path, the same rule as
# NEXUSFIX_WORKSPACE_ROOT applies — do not wrap it in double quotes, or "\n" and "\t" in the
# path are read as control characters.
#
# Last resort. Disables certificate verification entirely: the connection can no
# longer be authenticated and the credentials sent over it are exposed to anyone
# able to intercept the traffic. Use as a stopgap only.
# NEXUSFIX_INSECURE_SKIP_TLS_VERIFY=true

# --- Scanning method ------------------------------------------------------------------
# Default is a source-control scan: IQ reads what is committed. That is complete for npm
# (package-lock.json enumerates the whole tree) but NOT for Maven or Gradle, where the
# manifest names direct dependencies only and transitives are invisible.
#
# Set a jar URL and it scans the BUILT application instead, seeing the full classpath.
# The jar is downloaded once into <workspace_root>/tools/ and reused.
# NEXUSFIX_IQ_CLI_URL=https://download.sonatype.com/clm/scanner/nexus-iq-cli.jar
# NEXUSFIX_IQ_CLI_SHA256=<sha256 of that jar; logged on first download>

# Or point at a jar you already have, instead of downloading one:
# NEXUSFIX_IQ_CLI_JAR=/opt/nexus-iq-cli/nexus-iq-cli.jar

# Force one method regardless of the above. Useful to fall back to the source-control
# scan when a build is broken and you still want findings.
# NEXUSFIX_SCAN_METHOD=iq-cli | source-control

# Subdirectory of the checkout to scan. Defaults to the whole checkout, which finds
# artifacts wherever a multi-module build put them.
# NEXUSFIX_IQ_CLI_SCAN_TARGET=build
