# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
# See README.md "Configuration" section for what each of these does.

# --- Nexus IQ ---
NEXUSFIX_IQ_URL=https://iq.corp.example.com
NEXUSFIX_IQ_USERNAME=your-iq-user-token-id
NEXUSFIX_IQ_PASSWORD=your-iq-user-token-secret

# --- GitHub (or GitHub Enterprise Server) ---
NEXUSFIX_GITHUB_TOKEN=ghp_your_token_here
# Only needed for GHES; defaults to https://api.github.com if unset.
# NEXUSFIX_GITHUB_API_URL=https://ghes.corp.example.com/api/v3

# --- Defaults for `nexusfix run` (optional; --app-id / --branch override these) ---
# NEXUSFIX_APP_ID is the Nexus IQ *public* application ID, and must also be a key in
# config.yml's `repos:` map.
NEXUSFIX_APP_ID=payments-core
NEXUSFIX_BRANCH=main

# --- Optional ---
# Where mirror clones and per-run worktrees are created. Defaults to ~/nfx.
# NEXUSFIX_WORKSPACE_ROOT=/Users/you/nfx

# "mock" or "copilot". Selects the agent backend when wiring the CLI's --mock-agent
# flag through to a real Orchestrator (see README "What's real vs. unverified").
# NEXUSFIX_AGENT_BACKEND=copilot

# --- TLS (corporate proxy / self-signed CA) ---
# Preferred: point at your corporate root CA so certificates are still verified.
# NEXUSFIX_CA_BUNDLE=C:\certs\corporate-root-ca.pem
#
# Last resort. Disables certificate verification entirely: the connection can no
# longer be authenticated and the credentials sent over it are exposed to anyone
# able to intercept the traffic. Use as a stopgap only.
# NEXUSFIX_INSECURE_SKIP_TLS_VERIFY=true
