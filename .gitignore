__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
/dist/
.env
.env.local
state/*.db
runs/

# A fetched CA bundle normally lands in <workspace_root>/tools/, outside this tree
# entirely. These cover the case where NEXUSFIX_CA_BUNDLE points somewhere in the repo.
*.pem
corporate-ca.pem*
tests/fixtures/demo_gradle_repo/.gradle/
tests/fixtures/demo_gradle_repo/build/

# Machine/user-local, not project config — was previously excluded only via this
# machine's global git excludesfile (~/.config/git/ignore), which isn't portable
# to a fresh clone on another machine.
.claude/
.DS_Store
